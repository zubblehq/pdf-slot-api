{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:http": "node scripts/migrate-http.mjs"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@hono/zod-validator": "^0.9.1",
    "@pdf-slot/core": "*",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "hono": "^4.13.8",
    "pg": "^8.23.0",
    "pg-boss": "^12.37.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.9.1",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.11.0",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4"
  }
}
